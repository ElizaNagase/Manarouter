                "synchronous": [
                    {
                        "code": "lane_is_attended",
                        "message": "molab needs a person to open the session, so it cannot answer a request that arrives while nobody is watching",
                        "source": "https://docs.marimo.io/guides/molab/"
                    }
                ],
                "batch": [
                    {
                        "code": "lane_is_attended",
                        "message": "molab has no job API: work is started by hand and returns files, so it cannot be queued",
