{
  "lanes": [
    {
      "kind": "modal",
      "id": "modal",
      "display": "Modal",
      "shape": "serving",
      "inbound": "public-endpoint",
      "submission": "cli",
      "credentials": [
        "proxy-token-pair"
      ],
      "accounts": {
        "verdict": "allowed"
      },
      "max_session_secs": null,
      "idle_shutdown_secs": 60,
      "quota": [
        {
          "what": "gpu-concurrency",
          "limit": "10 GPUs on Starter, 50 on Team",
          "reset": null,
          "source": "https://modal.com/pricing"
        },
        {
          "what": "containers",
          "limit": "100 containers on Starter, 5000 on Team",
          "reset": null,
          "source": "https://modal.com/pricing"
        }
      ],
      "use_scope": null,
      "headline": "Serverless GPUs behind proxy tokens; a cold start per container and a 60 s idle shutdown by default.",
      "sources": [
        "https://modal.com/docs/guide/gpu.md",
        "https://modal.com/pricing",
        "https://modal.com/docs/guide/cold-start",
        "https://modal.com/docs/guide/webhook-urls"
      ],
      "can_serve_requests": true,
      "can_run_batch": true,
      "refusals": {
        "synchronous": [],
        "batch": []
      }
    },
    {
      "kind": "kaggle",
      "id": "kaggle",
      "display": "Kaggle Notebooks",
      "shape": "batch",
      "inbound": "none",
      "submission": "kernel-push",
      "credentials": [
        "api-token"
      ],
      "accounts": {
        "verdict": "prohibited",
        "clause": "You also may not have, control, or operate under more than one active Kaggle account or Kaggle User ID",
        "source": "https://www.kaggle.com/terms"
      },
      "max_session_secs": 43200,
      "idle_shutdown_secs": null,
      "quota": [
        {
          "what": "gpu-hours",
          "limit": "The quota resets weekly and is 30 hours or sometimes higher depending on demand and resources",
          "reset": "weekly",
          "source": "https://www.kaggle.com/docs/efficient-gpu-usage"
        },
        {
          "what": "tpu-hours",
          "limit": "up to 20 hours per week of TPUs and up to 9h at a time in a single session",
          "reset": "weekly",
          "source": "https://www.kaggle.com/docs/tpu"
        },
        {
          "what": "session-length",
          "limit": "12 h for CPU and GPU sessions, 9 h for TPU sessions",
          "reset": null,
          "source": "https://www.kaggle.com/docs/notebooks#technical-specifications"
        }
      ],
      "use_scope": {
        "text": "You will only use the Services for your own internal, personal, non-commercial use, and not on behalf of or for the benefit of any third party",
        "source": "https://www.kaggle.com/terms"
      },
      "headline": "Batch only: a submitted kernel takes minutes per call and returns files, never a live response; a second account is a Terms \u00a73 ban, and Kaggle's own docs disagree on whether an idle session dies at 20 or 60 minutes.",
      "sources": [
        "https://www.kaggle.com/docs/api",
        "https://github.com/Kaggle/kaggle-cli/blob/main/skills/references/auth.md",
        "https://github.com/Kaggle/kaggle-cli/blob/main/docs/kernels.md",
        "https://www.kaggle.com/docs/notebooks#technical-specifications",
        "https://www.kaggle.com/docs/efficient-gpu-usage",
        "https://www.kaggle.com/docs/tpu",
        "https://www.kaggle.com/terms"
      ],
      "can_serve_requests": false,
      "can_run_batch": true,
      "refusals": {
        "synchronous": [
          {
            "code": "lane_is_batch_only",
            "message": "Kaggle Notebooks runs submitted jobs and returns files; it has no endpoint a chat request can be answered from",
            "source": "https://www.kaggle.com/docs/api"
          }
        ],
        "batch": []
      }
    }
  ],
  "note": "Policy facts read from each platform's own documents, not live quotas. A \"refusal\" is the platform's rule quoted back, not this router's preference."
}
