# --- Rust ---
# No trailing slash: a `target` that has been relocated to another disk is a
# symlink, and `/target/` matches only a directory, so the link would show up as
# an untracked file and could be committed by accident.
/target
**/*.rs.bk
*.pdb

# --- local runtime state (never commit) ---
/.manarouter/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# --- secrets: must never be committed ---
secrets/
*.key
*.pem
.env
.env.*

# --- research scratch (kept locally, not published) ---
/.research/

# --- local test output ---
/e2e-evidence/
__pycache__/
*.pyc

# --- editor / OS ---
.idea/
.vscode/
*.swp
.DS_Store

# --- local backups ---
*.bak
plan.md.bak
